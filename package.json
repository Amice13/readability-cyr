{
  "name": "readability-cyr",
  "version": "1.1.1",
  "description": "Classic readability scores for Cyryllic and English texts",
  "scripts": {
    "ts-standard": "ts-standard src",
    "build-tsc": "tsc --project tsconfig.json",
    "build": "tsup",
    "dev": "node --inspect --watch-path=./src ./tests/tests.ts",
    "test": "node tests.ts"
  },
  "main": "./dist",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "ts-standard": {
    "project": "./tsconfig.json",
    "ignore": [
      "dist"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amice13/readability-cyr"
  },
  "type": "module",
  "keywords": [
    "ukrainian",
    "russian",
    "readability",
    "scores",
    "word",
    "sentence",
    "syllable",
    "Gunning Fog Score",
    "Flesch Kincaid Reading Grade",
    "Flesch Kincaid Reading Ease",
    "SMOG Index",
    "Automated Reability Index",
    "Coleman Liau Index",
    "Dale-Chall Readability Score",
    "Spache Readability Score",
    "ARI",
    "SMOG"
  ],
  "author": "Zakharov Kyrylo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Amice13/readability-cyr/issues"
  },
  "homepage": "https://github.com/Amice13/readability-cyr#readme",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "ts-standard": "^12.0.2",
    "tsup": "^8.5.1"
  }
}
